# ==========================================
# AI ASMR POC - Environment Variables
# ==========================================

# ------------------------------------------
# 1. LLM Provider Settings
# ------------------------------------------
# Selected provider option: "gemini", "openai", or "ollama"
LLM_PROVIDER=gemini

# Google Gemini API Key (Required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
# Optional comma-separated Gemini model fallbacks for transient 429/500/503 errors.
# Example: if GEMINI_MODEL is overloaded, app will retry using these models in order.
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-flash-latest

# OpenAI API Key (Required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Local Ollama Config (Required if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=ministral-3:8b

# ------------------------------------------
# 2. Text-to-Speech (TTS) Engine Settings
# ------------------------------------------
# Preferred TTS engine: "kokoro" or "edge-tts"
TTS_ENGINE=kokoro

# Voice preset for Kokoro (e.g., af_bella, af_alloy, am_adam)
KOKORO_VOICE=af_bella

# Voice preset for Edge-TTS (if using Edge-TTS)
EDGE_TTS_VOICE=en-US-AnaNeural

# ------------------------------------------
# 3. Application & Path Config
# ------------------------------------------
# Directory where generated ASMR audio files will be exported
OUTPUT_DIR=./output

# ------------------------------------------
# 4. Arabic TTS (SILMA/F5-TTS) Settings
# ------------------------------------------
# Arabic TTS backend: "silma" (local SILMA/F5-TTS) or "fish" (Fish Audio API)
ARABIC_TTS_BACKEND=silma

# Reference whisper clip for the Arabic voice. Best spec: 5-10s, mono,
# 24kHz+ dry-studio whisper. Prepare one from any source clip (wav/mp3) with:
#   python prepare_ref_audio.py input/test_asmr_tn_3.mp3 --start 0 --duration 8.3 \
#       -o input/ref_asmr_tn_24k.wav --ref-text-file input/test_asmr_tn_3.txt \
#       --strip-tags --sentences 0-2 --no-diacritize
# (--strip-tags removes Fish Audio [soft]/[whispering] tags; --sentences picks
# the transcript window matching the audio; --no-diacritize keeps an already
# exact transcript byte-for-byte - CRITICAL for F5 alignment)
ARABIC_REF_AUDIO=input/ref_asmr_tn_24k.wav

# Exact transcript of the reference clip (fully diacritized is best).
# If the file is missing, the inline fallback in tts.py is used.
ARABIC_REF_TEXT_PATH=input/test_asmr_tn_3.exact.txt

# Arabic diacritizer (tashkeel) backend: "mishkal", "camel", or "none".
# Install: uv pip install mishkal   (or: uv pip install camel-tools)
AR_DIACRITIZER=mishkal

# F5-TTS inference tuning
F5_TTS_DEVICE=cpu
# Diffusion steps: 32 (faster) - 50 (cleaner whisper transients)
F5_NFE_STEP=32
# Classifier-free guidance: 1.5-2.2; higher = stricter text adherence
F5_CFG_STRENGTH=2.0
# Sway sampling: -1.0 disables (KNOWN-GOOD). Positive values (e.g. 0.5)
# destroyed output in our sweep - change only after validating with:
#   python f5_asmr_inference.py --sweep
F5_SWAY_SAMPLING_COEF=-1.0
# Output loudness target used by F5 (RMS)
F5_TARGET_RMS=0.1

# ------------------------------------------
# 5. Fish Audio API (alternative Arabic TTS)
# ------------------------------------------
# Used when ARABIC_TTS_BACKEND=fish, and by fish_arabic_asmr_test.py.
# Get a free key at https://fish.audio -> API keys.
FISH_AUDIO_API_KEY=your_fish_audio_api_key_here
# Model string passed via the `model` HTTP header.
# s2.1-pro-free = $0 prototyping tier; switch to s2.1-pro for production.
FISH_AUDIO_MODEL=s2.1-pro-free
# Optional: reference_id of an Arabic ASMR community voice from the
# Fish Audio voice library. Leave empty to use the platform default voice.
FISH_AUDIO_VOICE_ID=