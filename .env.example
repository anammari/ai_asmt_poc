# ==========================================
# AI ASMR POC - Environment Variables
# ==========================================

# ------------------------------------------
# 1. LLM Provider Settings
# ------------------------------------------
# Provider for English transcripts: "openrouter", "gemini", "openai", or "ollama"
ENGLISH_LLM_PROVIDER=openrouter

# Provider for Arabic transcripts: "gemini" or "ollama" (defaults to ollama)
ARABIC_LLM_PROVIDER=ollama

# OpenRouter API Key (Required for English transcripts via OpenRouter)
# Get a key at https://openrouter.ai -> API keys.
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Model for English ASMR transcript generation via OpenRouter.
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Google Gemini API Key (Required if using gemini for either language)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
# Optional comma-separated Gemini model fallbacks for transient 429/500/503 errors.
# Example: if GEMINI_MODEL is overloaded, app will retry using these models in order.
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-flash-latest

# OpenAI API Key (Required if using openai for either language)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Local Ollama Config (Required if using ollama for either language)
OLLAMA_BASE_URL=http://localhost:11434
# Model for English transcripts via Ollama
ENGLISH_OLLAMA_MODEL=ministral-3:8b
# Model for Arabic transcripts via Ollama (fine-tuned Syrian ASMR model)
ARABIC_OLLAMA_MODEL=command-r7b-arabic:latest

# ------------------------------------------
# 2. Text-to-Speech (TTS) Settings
# ------------------------------------------
# TTS uses Fish Audio s2.1-pro-free for BOTH English and Arabic via fish_audio_tts.py.
# Get a free key at https://fish.audio -> API keys.
FISH_AUDIO_API_KEY=your_fish_audio_api_key_here
# Model string passed via the `model` HTTP header.
# s2.1-pro-free = $0 prototyping tier; switch to s2.1-pro for production.
FISH_AUDIO_MODEL=s2.1-pro-free
# Default voice ID; overridden per-session by the selected app voice.
# The app provides English and Arabic community ASMR voices mapped by tone.
# Leave empty to use the Fish Audio platform default voice.
FISH_AUDIO_VOICE_ID=

# ------------------------------------------
# 3. Application & Path Config
# ------------------------------------------
# Directory where generated ASMR audio files will be exported
OUTPUT_DIR=./output