# ==========================================
# AI ASMR POC - Environment Variables
# ==========================================

# ------------------------------------------
# 1. LLM Provider Settings
# ------------------------------------------
# Selected provider option: "gemini", "openai", or "ollama"
LLM_PROVIDER=gemini

# Google Gemini API Key (Required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
# Optional comma-separated Gemini model fallbacks for transient 429/500/503 errors.
# Example: if GEMINI_MODEL is overloaded, app will retry using these models in order.
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-flash-latest

# OpenAI API Key (Required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Local Ollama Config (Required if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=ministral-3:8b

# ------------------------------------------
# 2. Text-to-Speech (TTS) Engine Settings
# ------------------------------------------
# Preferred TTS engine: "kokoro" or "edge-tts"
TTS_ENGINE=kokoro

# Voice preset for Kokoro (e.g., af_bella, af_alloy, am_adam)
KOKORO_VOICE=af_bella

# Voice preset for Edge-TTS (if using Edge-TTS)
EDGE_TTS_VOICE=en-US-AnaNeural

# ------------------------------------------
# 3. Application & Path Config
# ------------------------------------------
# Directory where generated ASMR audio files will be exported
OUTPUT_DIR=./output

# ------------------------------------------
# 4. Arabic TTS (Fish Audio) Settings
# ------------------------------------------
# Arabic TTS uses Fish Audio s2.1-pro-free via fish_audio_tts.py.
# Get a free key at https://fish.audio -> API keys.
FISH_AUDIO_API_KEY=your_fish_audio_api_key_here
# Model string passed via the `model` HTTP header.
# s2.1-pro-free = $0 prototyping tier; switch to s2.1-pro for production.
FISH_AUDIO_MODEL=s2.1-pro-free
# Default voice ID; overridden per-session by the selected app voice.
# The app provides 4 community ASMR voices mapped by tone:
#   Whispering: ASMR 1 (0de68eaa...) and ASMR 2 (2689bc84...)
#   Soft Spoken: ASMR 3 (7eee0787...) and ASMR 4 (4ac8915e...)
# Leave empty to use the Fish Audio platform default voice.
FISH_AUDIO_VOICE_ID=